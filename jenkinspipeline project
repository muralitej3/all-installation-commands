pipeline {
    agent any

    environment {
        CPP_VER    = '1.15.0'
        JAVA_AGENT = '2.10.0'
    }

    stages {

        stage('code') {
            steps {
                git branch: 'main', url: 'https://github.com/muralitej3/Ecommerce-multi-services.git'
            }
        }

        stage('image') {
            steps {
                sh '''
                    docker build -f ./src/accounting/Dockerfile -t accounting:s2 .
                    docker build -f ./src/ad/Dockerfile -t ad:s2 .
                    docker build -f ./src/cart/src/Dockerfile -t cart:s2 .
                    docker build -f ./src/checkout/Dockerfile -t checkout:s2 .
                    docker build -f ./src/currency/Dockerfile --build-arg OPENTELEMETRY_CPP_VERSION=$CPP_VER -t currency:s2 .
                    docker build -f ./src/email/Dockerfile -t email:s2 .
                    docker build -f ./src/flagd-ui/Dockerfile -t flagd-ui:s2 .
                    docker build -f ./src/fraud-detection/Dockerfile \
                        --build-arg OTEL_JAVA_AGENT_VERSION=2.10.0 \
                        -t fraud-detection:s2 .
                    docker build -f ./src/frontend-proxy/Dockerfile -t frontend-proxy:s2 .
                    docker build -f ./src/frontend/Dockerfile -t frontend:s2 .
                    docker build -f ./src/image-provider/Dockerfile -t image-provider:s2 .
                    docker build -f ./src/kafka/Dockerfile \
                        --build-arg OTEL_JAVA_AGENT_VERSION=$JAVA_AGENT \
                        -t kafka:s2 .
                    docker build -f ./src/load-generator/Dockerfile -t load-generator:s2 .
                    docker build -f ./src/opensearch/Dockerfile -t opensearch:s2 .
                    docker build -f ./src/payment/Dockerfile -t payment:s2 .
                    docker build -f ./src/postgres/Dockerfile -t postgres:s2 .
                    docker build -f ./src/quote/Dockerfile -t quote:s2 .
                    docker build -f ./src/recommendation/Dockerfile -t recommendation:s2 .
                    docker build -f ./src/product-catalog/Dockerfile -t product-catalog:s2 .
                    docker build -f src/shipping/Dockerfile -t shipping:s2 .
                '''
            }
        }

        stage('Trivy') {
            steps {
                sh '''
                    trivy image accounting:s2 >> murali.txt
                    trivy image ad:s2 >> murali.txt
                    trivy image cart:s2 >> murali.txt
                    trivy image checkout:s2 >> murali.txt
                    trivy image currency:s2 >> murali.txt
                    trivy image email:s2 >> murali.txt
                    trivy image flagd-ui:s2 >> murali.txt
                    trivy image fraud-detection:s2 >> murali.txt
                    trivy image frontend-proxy:s2 >> murali.txt
                    trivy image frontend:s2 >> murali.txt
                    trivy image image-provider:s2 >> murali.txt
                    trivy image kafka:s2 >> murali.txt
                    trivy image load-generator:s2 >> murali.txt
                    trivy image opensearch:s2 >> murali.txt
                    trivy image payment:s2 >> murali.txt
                    trivy image postgres:s2 >> murali.txt
                    trivy image quote:s2 >> murali.txt
                    trivy image recommendation:s2 >> murali.txt
                    trivy image product-catalog:s2 >> murali.txt
                    trivy image shipping:s2 >> murali.txt
                '''
            }
        }

        stage('docker-hub') {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'murali') {
                        sh '''
                            docker tag accounting:s2       muraligorantla/accounting:s0
                            docker tag ad:s2               muraligorantla/ad:s0
                            docker tag cart:s2             muraligorantla/cart:s0
                            docker tag checkout:s2         muraligorantla/checkout:s0
                            docker tag currency:s2         muraligorantla/currency:s0
                            docker tag email:s2            muraligorantla/email:s0
                            docker tag flagd-ui:s2         muraligorantla/flagd-ui:s0
                            docker tag fraud-detection:s2  muraligorantla/fraud-detection:s0
                            docker tag frontend-proxy:s2   muraligorantla/frontend-proxy:s0
                            docker tag frontend:s2         muraligorantla/frontend:s0
                            docker tag image-provider:s2   muraligorantla/image-provider:s0
                            docker tag kafka:s2            muraligorantla/kafka:s0
                            docker tag load-generator:s2   muraligorantla/load-generator:s0
                            docker tag opensearch:s2       muraligorantla/opensearch:s0
                            docker tag payment:s2          muraligorantla/payment:s0
                            docker tag postgres:s2         muraligorantla/postgresql:s0
                            docker tag quote:s2            muraligorantla/quote:s0
                            docker tag recommendation:s2   muraligorantla/recommendation:s0
                            docker tag product-catalog:s2  muraligorantla/product-catalog:s0
                            docker tag shipping:s2 muraligorantla/shipping:s0

                            docker push muraligorantla/accounting:s0
                            docker push muraligorantla/ad:s0
                            docker push muraligorantla/cart:s0
                            docker push muraligorantla/checkout:s0
                            docker push muraligorantla/currency:s0
                            docker push muraligorantla/email:s0
                            docker push muraligorantla/flagd-ui:s0
                            docker push muraligorantla/fraud-detection:s0
                            docker push muraligorantla/frontend-proxy:s0
                            docker push muraligorantla/frontend:s0
                            docker push muraligorantla/image-provider:s0
                            docker push muraligorantla/kafka:s0
                            docker push muraligorantla/load-generator:s0
                            docker push muraligorantla/opensearch:s0
                            docker push muraligorantla/payment:s0
                            docker push muraligorantla/postgresql:s0
                            docker push muraligorantla/quote:s0
                            docker push muraligorantla/recommendation:s0
                            docker push muraligorantla/product-catalog:s0
                            docker push muraligorantla/shipping:s0
                        '''
                    }
                }
            }
        }
      

    }
}
